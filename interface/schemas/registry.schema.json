{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuyanglongyi1984.github.io/liubai-walkable/interface/schemas/registry.schema.json",
  "title": "Gate registry",
  "description": "Index of gates. The gates array holds live docks only. Examples are a separate array and are not worlds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["interface", "version", "updated", "self", "gates"],
  "properties": {
    "interface": { "const": "liubai" },
    "version": { "const": "1.0.0" },
    "updated": { "type": "string", "format": "date" },
    "self": { "const": "gates/registry.json" },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "href", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 48 },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "href": { "type": "string", "minLength": 1, "maxLength": 200 },
          "status": { "const": "live" }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "href", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 48 },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "href": { "type": "string", "minLength": 1, "maxLength": 200 },
          "status": { "const": "example" }
        }
      }
    }
  }
}
